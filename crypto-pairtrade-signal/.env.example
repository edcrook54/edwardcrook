# Copy to .env and fill in as needed. Not required for the core Kraken
# CSV pipeline - only needed if extending to CoinMetrics / Tardis.dev.

COINMETRICS_API_KEY=
TARDIS_API_KEY=

# Overrides for config/config.yaml defaults, if you keep data outside the repo
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
